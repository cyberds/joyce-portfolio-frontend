# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored; this file is the checked-in template.
# Restart `npm run dev` after any change — Next reads env at boot.
# ---------------------------------------------------------------------------

# ---- Existing: website chatbot --------------------------------------------
GEMINI_API_KEY=

# ---- Site --------------------------------------------------------------
# Used to build Stripe redirect URLs and the download links inside emails.
# MUST be the real, public origin in production — no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ISO 4217 code. Everything in the shop is priced in this one currency.
NEXT_PUBLIC_STORE_CURRENCY=GBP

# Shown to customers as the reply-to / support address.
SUPPORT_EMAIL=hello@joycewadawasina.com

# ---- A/B test: the journey section on the landing page -----------------
# Which variant of the "follow one enquiry" section renders on `/`.
#   roadmap  (default) — the pinned pipeline the camera travels down
#   cascade            — horizontal cards that stack on top of each other
# Anything else falls back to `roadmap`. This is inlined at build time, so a
# change needs a restart in dev and a redeploy in production.
# The standalone /journey page always uses `roadmap`.
NEXT_PUBLIC_JOURNEY_VARIANT=roadmap

# ---- MongoDB Atlas -----------------------------------------------------
# Atlas → Database → Connect → Drivers. Remember to URL-encode a password
# containing @ : / or ?, and to allow your server's IP in Network Access.
MONGODB_URI=mongodb+srv://cluster0.example.mongodb.net/somethingelse
MONGODB_DB=joyce_shop

# ---- Clerk (authentication) --------------------------------------------
# Clerk dashboard → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=exmample_key
CLERK_SECRET_KEY=sk_test_example_key

# Comma-separated emails that get into /admin. This is the bootstrap route in;
# the durable one is publicMetadata.role = "admin" on the Clerk user.
ADMIN_EMAILS=

# ---- Stripe (payments) -------------------------------------------------
# Stripe dashboard → Developers → API keys. Use sk_test_… until you go live.
STRIPE_SECRET_KEY=

# Webhooks → your endpoint → Signing secret (whsec_…).
# Endpoint URL:  https://your-domain.com/api/commerce/webhooks/stripe
# Events:        checkout.session.completed
#                checkout.session.async_payment_succeeded
#                checkout.session.async_payment_failed
#                checkout.session.expired
#                charge.refunded
# Locally, `stripe listen --forward-to localhost:3000/api/commerce/webhooks/stripe`
# prints a different whsec_ — use that one in development.
STRIPE_WEBHOOK_SECRET=

# ---- Cloudinary (media + digital goods) --------------------------------
# Cloudinary dashboard → Product Environment Credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- ZeptoMail (transactional email) -----------------------------------
# ZeptoMail → Mail Agents → your agent → Send Mail Token.
# Paste the token with or without the "Zoho-enczapikey " prefix; both work.
ZEPTOMAIL_TOKEN=

# api.zeptomail.eu for EU accounts, api.zeptomail.com for US.
ZEPTOMAIL_HOST=api.zeptomail.eu

# Must be an address on a domain verified in ZeptoMail, or sending fails.
ZEPTOMAIL_FROM_ADDRESS=
ZEPTOMAIL_FROM_NAME=Joyce Wadawasina
